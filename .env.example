# === App (públicas, expuestas al cliente) ===================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Kiosco Lucas"
NEXT_PUBLIC_WHATSAPP_NUMBER="542234360228"

# === Auth ===================================================================
# AUTH_SECRET y CRON_SECRET se generan con:
#   openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Whitelist de admins (CSV). Sumar emails si hay respaldos.
ADMIN_EMAILS="lucasivancardozo27@gmail.com"

# === DB =====================================================================
# Dev: postgres local en 5432 (reemplazar user/pass/host según setup local).
# Prod (Fase 6): connection string de Neon.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kiosco_gustavo?schema=public"

# === UploadThing ============================================================
# Lo completa Fase 3. Dejar vacío por ahora.
UPLOADTHING_TOKEN=

# === Cron ===================================================================
# Se usa en Fase 5 para autenticar el endpoint del cron job.
CRON_SECRET=
