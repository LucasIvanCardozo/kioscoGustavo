{
  "name": "kiosco-gustavo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "dotenv -e .env -- sh -c 'prisma migrate dev --name \"${MIGRATION_NAME:-init}\"'",
    "db:reset": "dotenv -e .env -- prisma migrate reset --force",
    "db:pr:reset": "dotenv -e .env.production -- prisma migrate reset --force",
    "db:studio": "dotenv -e .env -- prisma studio"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@uploadthing/react": "^7.3.3",
    "next": "^16.2.0",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.75.0",
    "react-hot-toast": "^2.6.0",
    "uploadthing": "^7.7.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.8.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
